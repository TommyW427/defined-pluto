- [soapy_plutosdr_source_0, '0', blocks_file_sink_raw, '0']
- [soapy_plutosdr_source_0, '0', qtgui_freq_sink_x_0, '0']

metadata:
  file_format: 1
  grc_version: 3.10.12.0
