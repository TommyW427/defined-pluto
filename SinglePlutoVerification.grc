    marker4: '0'
    marker5: '0'
    marker6: '0'
    marker7: '0'
    marker8: '0'
    marker9: '0'
    name: After Clock Recovery
    nconnections: '1'
    size: '1024'
    style1: '0'
    style10: '0'
